  characters:
  - data: {fileID: 11400000, guid: 4b506d1dbc63e204386db1ee0a9942ff, type: 2}
    icon: {fileID: 8793639957104055765, guid: fda3163a194878242a3c797baf8fe130, type: 3}
    role: Arcane initiate
    description: A fragile spellcaster with steady movement. Keep your distance and
      let your weapon do the work.
  - data: {fileID: 11400000, guid: 37ff0c52448833945a6724cd9494cb85, type: 2}
    icon: {fileID: 4723107735738678597, guid: a1498467a743dfc4cb789747800a5ee1, type: 3}
    role: Armored vanguard
    description: Built to endure. Higher starting health and recovery trade mobility
      for staying power.
  - data: {fileID: 11400000, guid: 1521a8f4907acd54999402ca17d5e5d4, type: 2}
    icon: {fileID: 4723107735738678597, guid: f7c3d8973019ebd44a4ea44f6a88a3fc, type: 3}
    role: Agile ranger
    description: Move fast, reposition often. The fastest hunter has less health
      to spare.
  - data: {fileID: 11400000, guid: 3cd6cdddab0918243a7451f0f6879bf9, type: 2}
    icon: {fileID: 4723107735738678597, guid: d6c75b71aa46a404fb23900f1c741b08, type: 3}
    role: Field survivor
    description: A balanced survivor with a generous pickup radius. Stay mobile and
      gather experience.
  weapons:
  - prefab: {fileID: 9218329595843393466, guid: a30d23a3c73590d4a9c897b14db3391f, type: 3}
    icon: {fileID: -5636343253877202797, guid: 8938565178465c64bbed4730c19b61e9, type: 3}
    title: Sword
    role: Melee / sweeping arc
    description: A close-range sweeping strike. Catch multiple enemies in the arc
      of your blade.
  - prefab: {fileID: 343300575173549981, guid: 31c22699d8f19504f8e12cdefb592673, type: 3}
    icon: {fileID: 1217285670161488190, guid: 2279221a72b7c7c43912401c8dcfd6e8, type: 3}
    title: Magic Book
    role: Ranged / magazine
    description: Fire magic projectiles toward your aim. Manage your magazine and
      make room to reload.
  - prefab: {fileID: 6457568805044639683, guid: 7bb5c6d34fe1cf94bb9ef60a22eea46d, type: 3}
    icon: {fileID: 7775967760938375176, guid: ab9507ccf62ce6844b6eb341649e8a70, type: 3}
    title: Bow
    role: Ranged / arrow recovery
    description: Loose arrows and recover your ammunition over time. Keep a rhythm
      and stay on the move.
  - prefab: {fileID: 5274142845828472441, guid: 3794c78a37a5d2542b67d96661a906c8, type: 3}
    icon: {fileID: 4475123825542513644, guid: 77b00e15002985448a335c76b465546c, type: 3}
    title: Crossbow
    role: Ranged / charged shot
    description: Hold your shot to charge a stronger bolt. Release at the right moment
      for a decisive hit.
